{
  "displayName": "Metis API 5xx rate high",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Caddy 5xx responses exceed five percent",
      "conditionThreshold": {
        "filter": "resource.type=\"gce_instance\" AND metric.type=\"logging.googleapis.com/user/metis_caddy_5xx\"",
        "denominatorFilter": "resource.type=\"gce_instance\" AND metric.type=\"logging.googleapis.com/user/metis_caddy_requests\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.05,
        "duration": "120s",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "denominatorAggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "trigger": {"count": 1}
      }
    }
  ],
  "documentation": {
    "mimeType": "text/markdown",
    "content": "More than five percent of Caddy requests have returned 5xx for two minutes. Inspect the API and Caddy journals using the incident time range."
  }
}
