{
  "$defs": {
    "ConnectorConfig": {
      "additionalProperties": false,
      "description": "Local-folder roots and globs. Provider connectors add their own filters later.",
      "properties": {
        "backfill_days": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Backfill Days",
          "type": "integer"
        },
        "exclude_globs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Exclude Globs",
          "type": "array"
        },
        "include_globs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Include Globs",
          "type": "array"
        },
        "paths": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Paths",
          "type": "array"
        },
        "sync_interval_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 60,
          "title": "Sync Interval Seconds",
          "type": "integer"
        }
      },
      "title": "ConnectorConfig",
      "type": "object"
    },
    "ConnectorKind": {
      "enum": [
        "local_folder",
        "gmail",
        "gdrive"
      ],
      "title": "ConnectorKind",
      "type": "string"
    },
    "ConnectorStatus": {
      "enum": [
        "active",
        "paused",
        "needs_auth",
        "error"
      ],
      "title": "ConnectorStatus",
      "type": "string"
    }
  },
  "$id": "https://metis.local/schemas/v1/Connector.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A data stream Metis syncs from. Secrets are never stored here: OAuth\ntokens live in the OS credential store, keyed by connector id.",
  "properties": {
    "allow_cloud_models": {
      "default": false,
      "title": "Allow Cloud Models",
      "type": "boolean"
    },
    "config": {
      "$ref": "#/$defs/ConnectorConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "item_count": {
      "default": 0,
      "minimum": 0,
      "title": "Item Count",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/ConnectorKind"
    },
    "last_error": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "last_sync_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Sync At"
    },
    "next_sync_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Sync At"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ConnectorStatus",
      "default": "active"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "user_id",
    "created_at",
    "updated_at",
    "kind",
    "title"
  ],
  "title": "Connector",
  "type": "object",
  "x-contract-version": 1
}
