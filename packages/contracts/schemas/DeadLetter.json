{
  "$id": "https://metis.local/schemas/v1/DeadLetter.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "title": "Attempts",
      "type": "integer"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "lane": {
      "enum": [
        "interactive",
        "ingest"
      ],
      "title": "Lane",
      "type": "string"
    },
    "target_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "lane",
    "attempts",
    "updated_at"
  ],
  "title": "DeadLetter",
  "type": "object",
  "x-contract-version": 1
}
