{
  "$id": "https://metis.local/schemas/v1/HealthResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Unauthenticated callers get only ``status`` and ``contract_version``;\nmode, adapters and build are returned to an authenticated caller.",
  "properties": {
    "adapters": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapters"
    },
    "build": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build"
    },
    "contract_version": {
      "title": "Contract Version",
      "type": "integer"
    },
    "mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mode"
    },
    "status": {
      "enum": [
        "ok",
        "degraded"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "contract_version"
  ],
  "title": "HealthResponse",
  "type": "object",
  "x-contract-version": 1
}
