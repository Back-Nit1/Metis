{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "One retrieved, source-backed justification shown to the user.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        },
        "excerpt": {
          "maxLength": 2000,
          "title": "Excerpt",
          "type": "string"
        },
        "matched": {
          "items": {
            "enum": [
              "semantic",
              "keyword"
            ],
            "type": "string"
          },
          "title": "Matched",
          "type": "array"
        },
        "memory_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "origin": {
          "default": "memory",
          "enum": [
            "memory",
            "file",
            "email",
            "drive"
          ],
          "title": "Origin",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "span_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Ref"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "uri": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "validity": {
          "default": "current",
          "enum": [
            "current",
            "historical",
            "superseded",
            "uncertain"
          ],
          "title": "Validity",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "excerpt",
        "recorded_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "idea",
        "observation",
        "hypothesis",
        "decision",
        "commitment",
        "work_log",
        "attempt",
        "blocker",
        "preference"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "SearchResult": {
      "additionalProperties": false,
      "description": "One hybrid-retrieval hit. ``evidence`` is the citation shown to the user.\n\nMemory hits set ``memory_id`` + ``kind``; corpus hits (files, email, Drive)\nset ``chunk_id`` and leave ``kind`` null.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "score": {
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "content",
        "score",
        "evidence"
      ],
      "title": "SearchResult",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/SearchResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decomposition": {
      "default": "none",
      "enum": [
        "none",
        "parallel",
        "sequential"
      ],
      "title": "Decomposition",
      "type": "string"
    },
    "degraded_reason": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degraded Reason"
    },
    "index_available": {
      "default": true,
      "title": "Index Available",
      "type": "boolean"
    },
    "index_stale": {
      "default": false,
      "title": "Index Stale",
      "type": "boolean"
    },
    "mode_used": {
      "title": "Mode Used",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchResult"
      },
      "title": "Results",
      "type": "array"
    },
    "sub_queries": {
      "items": {
        "maxLength": 1000,
        "type": "string"
      },
      "maxItems": 5,
      "title": "Sub Queries",
      "type": "array"
    }
  },
  "required": [
    "mode_used"
  ],
  "title": "SearchResponse",
  "type": "object",
  "x-contract-version": 1
}
