    {"id": "src_cerno_demo", "user": "user_a", "current_version": 2},
    {"id": "src_themis_price", "user": "user_a", "current_version": 2},
    {"id": "src_themis_misc", "user": "user_a", "current_version": 1},
    {"id": "src_home", "user": "user_a", "current_version": 1},
