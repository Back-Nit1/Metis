    {"id": "m_b01", "user": "user_b", "project": "proj_b_cerno", "kind": "attempt", "source": "src_b_notes", "content": "Tried caching whole files between review runs; the cache went stale after rebases."},
    {"id": "m_b02", "user": "user_b", "project": "proj_b_cerno", "kind": "observation", "source": "src_b_notes", "content": "Error CRN-4021 shows up when the webhook secret is rotated."},
    {"id": "m_b03", "user": "user_b", "kind": "commitment", "source": "src_b_notes", "content": "My CMU application is due December 1."},
    {"id": "m_b04", "user": "user_b", "kind": "observation", "source": "src_b_notes", "content": "Bayside Movers quoted 1450 dollars."}
