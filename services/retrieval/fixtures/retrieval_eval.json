    {"id": "m_h03", "user": "user_a", "project": "proj_home", "kind": "decision", "source": "src_home", "content": "Going with Bayside Movers for the move."},
    {"id": "m_h04", "user": "user_a", "project": "proj_home", "kind": "idea", "source": "src_home", "content": "Maybe sell the couch instead of moving it."},
    {"id": "m_h05", "user": "user_a", "project": "proj_home", "kind": "blocker", "source": "src_home", "content": "Cannot book the elevator at the new building until the lease is countersigned."},

    {"id": "m_f01", "user": "user_a", "project": "proj_fitness", "kind": "preference", "source": "src_fitness", "content": "I like doing focus work in the morning and running after 5pm."},
    {"id": "m_f02", "user": "user_a", "project": "proj_fitness", "kind": "attempt", "source": "src_fitness", "content": "Tried running at 6am for two weeks; kept skipping it, so I moved runs to the evening."},
    {"id": "m_f03", "user": "user_a", "project": "proj_fitness", "kind": "commitment", "source": "src_fitness", "content": "Signed up for the Brooklyn half marathon in March."},
    {"id": "m_f04", "user": "user_a", "project": "proj_fitness", "kind": "observation", "source": "src_fitness", "content": "Left knee hurts after runs longer than 10 km."},

    {"id": "m_x01", "user": "user_a", "kind": "idea", "source": "src_misc", "content": "Want to attend the Bloomberg fintech summit in New York this spring."},
    {"id": "m_x02", "user": "user_a", "kind": "commitment", "source": "src_misc", "content": "Grad school application for CMU is due December 1."},
