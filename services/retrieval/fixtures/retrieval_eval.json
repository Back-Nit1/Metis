  "memories": [
    {"id": "m_c01", "user": "user_a", "project": "proj_cerno", "kind": "attempt", "source": "src_cerno_cache", "content": "Tried caching whole files between review runs; abandoned it because the cache went stale whenever a branch was rebased."},
    {"id": "m_c02", "user": "user_a", "project": "proj_cerno", "kind": "decision", "source": "src_cerno_cache", "content": "Decided to cache per-hunk diffs keyed by blob SHA instead of whole files."},
    {"id": "m_c03", "user": "user_a", "project": "proj_cerno", "kind": "blocker", "source": "src_cerno_cache", "content": "Diff-aware invalidation is blocked on rename detection from git; renamed files show up as a delete plus an add."},
    {"id": "m_c04", "user": "user_a", "project": "proj_cerno", "kind": "observation", "source": "src_cerno_cache", "content": "The reviewer re-reads unchanged files on every run, which is why reviews take four minutes on large pull requests."},
    {"id": "m_c05", "user": "user_a", "project": "proj_cerno", "kind": "decision", "validity": "superseded", "source": "src_cerno_queue", "content": "We will use Kafka to fan review jobs out to workers."},
    {"id": "m_c06", "user": "user_a", "project": "proj_cerno", "kind": "decision", "source": "src_cerno_queue", "content": "Dropped Kafka; review jobs now go through a plain SQS queue because the volume is tiny."},
    {"id": "m_c07", "user": "user_a", "project": "proj_cerno", "kind": "observation", "source": "src_cerno_misc", "content": "Error CRN-4021 appears when the GitHub webhook signature check fails after a secret rotation."},
    {"id": "m_c08", "user": "user_a", "project": "proj_cerno", "kind": "work_log", "source": "src_cerno_misc", "content": "Fixed the flaky test in cerno-api.ts by freezing the clock instead of sleeping."},
    {"id": "m_c09", "user": "user_a", "project": "proj_cerno", "kind": "idea", "source": "src_cerno_misc", "content": "Idea, not decided: let reviewers thumbs-down a comment so Cerno learns which nits to skip."},
    {"id": "m_c10", "user": "user_a", "project": "proj_cerno", "kind": "decision", "source": "src_cerno_cache", "content": "Do not use Redis for the review cache; a SQLite file per repo is enough and avoids running another server."},
    {"id": "m_c11", "user": "user_a", "project": "proj_cerno", "kind": "preference", "source": "src_cerno_misc", "content": "I prefer Cerno comments grouped by file, not one long list."},
    {"id": "m_c12", "user": "user_a", "project": "proj_cerno", "kind": "commitment", "source": "src_cerno_demo", "source_version": 1, "content": "Cerno demo for the design partners is on November 12."},
    {"id": "m_c13", "user": "user_a", "project": "proj_cerno", "kind": "commitment", "source": "src_cerno_demo", "source_version": 2, "content": "Cerno demo for the design partners moved to November 19 because Priya is travelling."},
    {"id": "m_del01", "user": "user_a", "project": "proj_cerno", "kind": "decision", "source": "src_cerno_cache", "deleted": true, "content": "The Cerno review cache lives in Redis."},

    {"id": "m_t00", "user": "user_a", "project": "proj_themis", "kind": "decision", "source": "src_themis_price", "source_version": 1, "content": "Themis pricing: 9 dollars per month with a free tier."},
    {"id": "m_t01", "user": "user_a", "project": "proj_themis", "kind": "decision", "source": "src_themis_price", "source_version": 2, "content": "Themis pricing: flat 12 dollars per month, no free tier."},
    {"id": "m_t02", "user": "user_a", "project": "proj_themis", "kind": "idea", "source": "src_themis_misc", "content": "Thinking about usage-based pricing for Themis, but have not decided."},
    {"id": "m_t03", "user": "user_a", "project": "proj_themis", "kind": "attempt", "source": "src_themis_misc", "content": "Tried caching exchange rates in Themis for a whole day; customers saw wrong invoice totals when rates moved, so I reverted to an hourly refresh."},
    {"id": "m_t04", "user": "user_a", "project": "proj_themis", "kind": "blocker", "source": "src_themis_misc", "content": "Themis Stripe integration is blocked until the business bank account is verified."},
    {"id": "m_t05", "user": "user_a", "project": "proj_themis", "kind": "observation", "source": "src_themis_misc", "content": "Error THM-502 means the PDF renderer timed out on invoices with more than 200 line items."},
    {"id": "m_t06", "user": "user_a", "project": "proj_themis", "kind": "decision", "validity": "superseded", "source": "src_themis_misc", "content": "Themis frontend will be built with Next.js."},
    {"id": "m_t07", "user": "user_a", "project": "proj_themis", "kind": "decision", "source": "src_themis_misc", "content": "Switched the Themis frontend to plain Vite and React since there is no server rendering need."},
    {"id": "m_t08", "user": "user_a", "project": "proj_themis", "kind": "work_log", "source": "src_themis_misc", "content": "Wrote the invoice numbering migration in themis_invoices_0007.sql."},

    {"id": "m_h01", "user": "user_a", "project": "proj_home", "kind": "commitment", "source": "src_home", "content": "Must give the landlord 60 days notice before leaving the Elm Street apartment."},
